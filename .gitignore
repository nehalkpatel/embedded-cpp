# Build output
build/
Testing/
CMakeUserPresets.json

# Coverage counters. The Debug preset builds with CODE_COVERAGE, and every run
# of an instrumented binary drops one of these wherever it was invoked from --
# usually the repo root.
*.profraw
*.profdata

# Editor / tooling
.vscode/
.cache/
.claude/settings.local.json
.DS_Store

# Symlink into the configured build tree, recreated at configure time by the
# root CMakeLists.txt.
/compile_commands.json

# Python
__pycache__/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Reference material (not source)
/ProfessionalCMake_21st_Edition.pdf
/ProfessionalCMake_21st_Edition.txt
